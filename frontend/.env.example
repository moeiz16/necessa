# Backend origin used by the Next.js rewrite for /api/v1 (server-side only)
NECESSA_API_ORIGIN=http://localhost:8000

# API base path used by the browser (keep same-origin so auth cookies work)
NEXT_PUBLIC_API_BASE=/api/v1

# true = always use the in-browser demo backend (no API, no keys) — ideal for static previews
NEXT_PUBLIC_DEMO_MODE=false

# Absolute site URL (OG images, metadata)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
