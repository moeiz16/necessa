# ─────────────────────────────────────────────────────────────────────────────
# Necessa — environment template. Copy to `.env` and fill what you have.
# Every provider key is optional: missing keys simply disable that deployment,
# and the platform degrades gracefully (sparse-only retrieval, heuristic review).
# ─────────────────────────────────────────────────────────────────────────────

ENVIRONMENT=dev
PUBLIC_APP_URL=http://localhost:3000
CORS_ORIGINS=["http://localhost:3000"]
LOG_LEVEL=INFO

# Security — generate real values for anything beyond local dev:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
SECRET_KEY=change-me
PHI_ENCRYPTION_KEY=

# ── Data stores (managed free tiers; no local servers required) ─────────────
# Neon Postgres (free): postgresql+asyncpg://USER:PASSWORD@HOST/DB?ssl=require
# Leave the SQLite default for a zero-signup local run.
DATABASE_URL=sqlite+aiosqlite:///./necessa-dev.db
# Qdrant Cloud (free 1 GB cluster). Empty = embedded local mode under data/qdrant.
QDRANT_URL=
QDRANT_API_KEY=
# Upstash Redis (free). Empty = in-process cache / rate limits / pub-sub.
REDIS_URL=

# ── LLM providers (free tiers) ──────────────────────────────────────────────
GROQ_API_KEY=
GEMINI_API_KEY=
OPENROUTER_API_KEY=
COHERE_API_KEY=
JINA_API_KEY=
MISTRAL_API_KEY=
CEREBRAS_API_KEY=
GITHUB_MODELS_TOKEN=
# Deterministic offline fakes for every LLM/embedding/rerank call (tests, demos without keys)
LLM_FAKE=false

# Embeddings — the index is pinned to ONE model; changing it requires a re-index.
EMBEDDING_MODEL=gemini/gemini-embedding-001
EMBEDDING_DIMS=768

# ── Observability (optional) ────────────────────────────────────────────────
LANGFUSE_PUBLIC_KEY=
LANGFUSE_SECRET_KEY=
LANGFUSE_HOST=https://cloud.langfuse.com

# ── Data ingestion ──────────────────────────────────────────────────────────
# Downloading the CMS Medicare Coverage Database means accepting the AMA/ADA/AHA
# license terms shown on the MCD downloads page. Data stays local and is git-ignored.
ACCEPT_CMS_LICENSE=false
INGEST_SCOPE=focus

# Seed a demo organization with synthetic patients and cases on startup
DEMO_MODE=false
