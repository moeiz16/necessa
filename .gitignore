# ── Data (CMS MCD content carries AMA/ADA/AHA license terms — never commit) ──
data/*
!data/.gitkeep
*.mdb
*.zip

# ── Secrets ──
.env
.env.*
!.env.example
*.pem
*.key

# ── Python ──
__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
*.db
*.db-journal
*.db-wal
*.db-shm

# ── Node / Next.js ──
node_modules/
.next/
out/
.turbo/
.vercel/
*.tsbuildinfo
next-env.d.ts
npm-debug.log*
.pnpm-store/

# ── Eval artifacts ──
eval/reports/*.json
eval/reports/*.html
!eval/reports/.gitkeep

# ── OS / editors ──
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json
*.swp
